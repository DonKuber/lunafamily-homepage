---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import LaptopFrame from '../components/LaptopFrame.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import CalloutChip from '../components/Callout.astro';
import { IC } from '../data/icons';
import { CATEGORIES, STATUS, STATUS_ORDER, isPublished, screenshotsFor, shotByFile, type Callout, type Status } from '../data/features';

const HERO_SHOT = screenshotsFor('hero')[0];
// Laptop und Handy zusammen zeigen: zu Hause am Rechner, unterwegs am Handy.
const HERO_PHONE = shotByFile('phone-kalender');
const HERO_CALLOUTS: Callout[] = [
  { text: 'Für die ganze Familie', x: -7, y: 22, icon: 'users' },
  { text: 'Termine und Aufgaben auf einen Blick', x: 70, y: -5, icon: 'check' },
  { text: 'Auch unterwegs dabei', x: 60, y: 97, icon: 'heart' },
];

const WHY_CARDS = [
  { icon: IC.shield, color: 'text-green-500', title: 'Deine Daten. Deine Regeln.',     text: 'Keine Werbeanzeigen, kein Tracking, kein Datenverkauf. Was in deiner Familie passiert, bleibt in deiner Familie.' },
  { icon: IC.heart,  color: 'text-rose-500',  title: 'Entspannt durch den Alltag',     text: 'Weniger Stress, weniger Chaos — mehr Zeit für die Momente, die wirklich zählen. LunaFamily übernimmt die Koordination.' },
  { icon: IC.users,  color: 'text-primary',   title: 'Für die ganze Familie',          text: 'Jedes Familienmitglied hat sein eigenes Profil. Geteilte Inhalte, private Bereiche — du entscheidest.' },
  { icon: IC.sparkles, color: 'text-primary',   title: 'Lästige Dinge einfach automatisieren', text: 'E-Mails werden zu Aufgaben, eingehende Rechnungen landen als Wiedervorlage, KI-Antworten sind in Sekunden fertig — LunaFamily erledigt die Kleinarbeit im Hintergrund.' },
  { icon: IC.clock,    color: 'text-amber-500', title: 'Einmal einrichten. Dauerhaft gewinnen.', text: 'Ja, der Start braucht etwas Zeit — dafür läuft euer Alltag danach fast von allein. Mehr Kopf frei für das, was im Leben wirklich wichtig ist.' },
  { icon: IC.flask,  color: 'text-primary',   title: 'Du gestaltest mit',              text: 'Als Beta-Nutzer hast du direkten Einfluss. Wir bauen, was echte Familien wirklich brauchen.' },
];

const BETA_CARDS = [
  { icon: IC.flask,       color: 'text-primary',   title: 'Aktive Entwicklung',                    text: 'LunaFamily wird täglich weiterentwickelt. Jede Woche kommen neue Features und Verbesserungen.' },
  { icon: IC.star,        color: 'text-amber-500', title: 'Dein Feedback formt das Produkt',       text: 'Als Early Adopter hast du direkten Einfluss. Was dir fehlt, bauen wir als nächstes.' },
  { icon: IC.heart,       color: 'text-rose-500',  title: 'Free Family bleibt kostenlos',          text: 'Der Free-Plan ist und bleibt dauerhaft kostenlos. Wer jetzt alles nutzen möchte, wird Beta Supporter für 5 €/Monat — und sichert sich nach 3 Zahlungen lebenslangen 15 % Rabatt.' },
  { icon: IC.shield,      color: 'text-green-500', title: 'Sicherheit ist keine Beta-Funktion',    text: 'Verschlüsselung und Malware-Schutz für eure Daten — Sicherheit ist von Anfang an eingebaut, nicht nachträglich.' },
  { icon: IC.clock,       color: 'text-blue-500',  title: 'Module rollen schrittweise aus',        text: 'Nicht alle Module sind sofort verfügbar. Wir schalten sie frei, sobald sie stabil und getestet sind.' },
  { icon: IC.zap,         color: 'text-primary',   title: 'Schnelle Bug-Fixes',                    text: 'Wenn etwas nicht stimmt, beheben wir es schnell. Transparente Kommunikation ist uns wichtig.' },
];

// Die Roadmap folgt dem Status der Module in data/features.ts.
const titlesWith = (...statuses: Status[]) =>
  CATEGORIES.filter((c) => statuses.includes(c.status)).map((c) => (c.status === 'partial' ? `${c.title} (teilweise)` : c.title));
const ROADMAP_DONE = titlesWith('available', 'partial');
const ROADMAP_SOON = titlesWith('soon');
const ROADMAP_PLANNED = titlesWith('planned');

---

<Base
  title="LunaFamily – Das digitale Zuhause für deine Familie"
  description="Kalender, Aufgaben, Dokumente, Verträge, Kontakte und vieles mehr — alles an einem Ort, für die ganze Familie. Endlich Schluss mit Zettel-Chaos und App-Wirrwarr."
>

<style is:global>
  @keyframes lf-float1 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(40px,-50px)} }
  @keyframes lf-float2 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-30px,40px)} }
  @keyframes lf-float3 { 0%,100%{transform:translate(-50%,-50%)} 50%{transform:translate(-50%,calc(-50% - 25px))} }
  @keyframes lf-hover { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
  .lf-float { animation: lf-hover 7s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) { .lf-float { animation: none; } }
  @keyframes lf-fadein  { from{opacity:0;transform:translateY(2.5rem)} to{opacity:1;transform:translateY(0)} }

  .lf-hero { animation: lf-fadein 1s ease forwards; }

</style>

<SiteNav />

<!-- ─── Beta Banner ───────────────────────────────────────────────────────── -->
<div class="bg-amber-50 dark:bg-amber-950/30 border-b border-amber-200 dark:border-amber-800/50 py-2.5 px-4 text-center mt-16">
  <p class="text-sm text-amber-800 dark:text-amber-200 flex items-center justify-center gap-2 flex-wrap">
    <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <Fragment set:html={IC.flask} />
    </svg>
    <span>
      <strong>Öffentliche Beta:</strong> LunaFamily wird aktiv weiterentwickelt. Module werden schrittweise freigeschaltet.
    </span>
    <a href="mailto:feedback@lunafamily.de" class="underline font-medium hover:text-amber-900 dark:hover:text-amber-100 transition-colors">
      Feedback geben →
    </a>
  </p>
</div>

<!-- ─── Hero ──────────────────────────────────────────────────────────────── -->
<section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden" aria-labelledby="hero-heading">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-background"></div>
    <div class="absolute top-1/3 -left-40 w-[600px] h-[600px] rounded-full opacity-[0.18]"
         style="background:radial-gradient(circle,#c4a265 0%,transparent 65%);animation:lf-float1 9s ease-in-out infinite" aria-hidden="true"></div>
    <div class="absolute bottom-1/4 -right-40 w-[500px] h-[500px] rounded-full opacity-[0.14]"
         style="background:radial-gradient(circle,#d4b378 0%,transparent 65%);animation:lf-float2 12s ease-in-out infinite" aria-hidden="true"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] rounded-full opacity-[0.10]"
         style="background:radial-gradient(circle,#8fae6b 0%,transparent 65%);animation:lf-float3 15s ease-in-out infinite" aria-hidden="true"></div>
  </div>

  <div class="lf-hero max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border text-sm font-medium mb-8"
         style="background:rgba(196,162,101,.1);border-color:rgba(196,162,101,.3);color:#c4a265">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <Fragment set:html={IC.flask} />
      </svg>
      Early Access Beta — Jetzt kostenlos mitmachen
    </div>

    <h1 id="hero-heading" class="font-display text-4xl sm:text-5xl lg:text-7xl font-bold text-foreground mb-6 leading-[1.15] tracking-tight">
      Das digitale{' '}
      <span class="font-script text-[1.2em] inline-block pr-3 pb-1" style="background:linear-gradient(90deg,#c4a265,#c09556,#c4a265);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
        Zuhause
      </span>{' '}
      für deine Familie.
    </h1>

    <p class="text-lg sm:text-xl text-muted-foreground mb-12 max-w-2xl mx-auto leading-relaxed">
      Vergessene Termine, verlegte Dokumente, "wer kümmert sich eigentlich um was?" — kennt jede Familie. LunaFamily bringt Kalender, Aufgaben, Dokumente, Verträge und Kontakte an einen Ort, damit ihr wieder Kopf frei habt für das, was wirklich zählt.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-14">
      <a href="https://app.lunafamily.online/register"
         class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-primary-foreground font-semibold px-10 py-4 text-base rounded-xl transition-colors"
         style="box-shadow:0 20px 40px rgba(196,162,101,.25)" rel="noopener">
        Jetzt kostenlos registrieren
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <Fragment set:html={IC.arrowRight} />
        </svg>
      </a>
      <a href="https://app.lunafamily.online/login"
         class="w-full sm:w-auto inline-flex items-center justify-center border border-border bg-card text-foreground font-semibold px-10 py-4 text-base rounded-xl hover:bg-muted transition-colors"
         rel="noopener">
        Bereits registriert? Anmelden
      </a>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-muted-foreground">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.zap} /></svg>
        In wenigen Minuten startklar
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.heart} /></svg>
        Kostenlos in der Beta
      </span>
      <span class="flex items-center gap-1.5" style="color:#7d7060">
        <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="#c4a265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.smartphone} /></svg>
        Web & Mobile
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.checkCheck} /></svg>
        Keine Kreditkarte nötig
      </span>
    </div>
  </div>
</section>

{HERO_SHOT && (
  <section class="px-4 sm:px-6 -mt-6 pb-24 lg:pb-32" aria-label="Einblick in die App">
    <div class="lf-animate relative max-w-6xl mx-auto">
      <div class="absolute inset-x-0 lg:-inset-x-10 -inset-y-16 -z-10 rounded-[3rem]" aria-hidden="true"
           style="background:radial-gradient(55% 55% at 45% 45%, rgb(196 162 101 / .28), transparent 70%),radial-gradient(35% 40% at 85% 80%, rgb(143 174 107 / .18), transparent 70%)"></div>
      <div class="relative lg:mr-[10%]">
        <LaptopFrame shot={HERO_SHOT} eager />
        {HERO_PHONE && (
          <PhoneFrame shot={HERO_PHONE} class="absolute -right-[2%] lg:-right-[13%] -bottom-[8%] w-[27%] lg:w-[23%] lf-float" />
        )}
        {HERO_CALLOUTS.map((c, i) => (
          <CalloutChip callout={c} class="hidden lg:inline-flex absolute z-10 lf-float" style={`left:${c.x}%;top:${c.y}%;animation-delay:${-i * 2.5}s`} />
        ))}
      </div>
      <div class="flex lg:hidden flex-wrap justify-center gap-2 mt-16">
        {HERO_CALLOUTS.map((c) => <CalloutChip callout={c} />)}
      </div>
    </div>
    <p class="mt-16 lg:mt-24 text-center text-sm text-muted-foreground">Echte Aufnahmen aus LunaFamily – mit einer erfundenen Beispielfamilie.</p>
  </section>
)}

<!-- ─── Features ─────────────────────────────────────────────────────────── -->
<section class="py-24 px-4 sm:px-6 bg-muted/20" aria-labelledby="features-heading">
  <div class="max-w-6xl mx-auto">
    <div class="lf-animate text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-sm font-medium mb-5"
           style="background:rgba(196,162,101,.1);border-color:rgba(196,162,101,.3);color:#c4a265">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <Fragment set:html={IC.sparkles} />
        </svg>
        {CATEGORIES.length} Module, ein System
      </div>
      <h2 id="features-heading" class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground mb-5">
        Alles, was deine <span class="font-script text-accent text-[1.15em]">Familie</span> braucht
      </h2>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto leading-relaxed">
        LunaFamily vereint alle wichtigen Funktionen für den Familienalltag in einer einzigen, sicheren Plattform — statt vieler verschiedener Apps.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {CATEGORIES.map((cat, i) => {
        const st = STATUS[cat.status];
        // Noch nicht freigeschaltete Module: Karte ohne Link (siehe data/features.ts).
        const published = isPublished(cat);
        const isComingSoon = !published;
        const Card = published ? 'a' : 'div';
        return (
          <div class="lf-animate" style={`transition-delay:${Math.min(i * 50, 300)}ms`}>
            <Card href={published ? `/funktionen/${cat.slug}` : undefined} class={`group flex flex-col h-full border border-border bg-card rounded-2xl p-6 transition-all duration-300 ${published ? 'hover:shadow-md hover:-translate-y-0.5' : 'opacity-75'}`}>
              <div class="flex items-start justify-between mb-4">
                <div class={`p-3 rounded-xl bg-gradient-to-br ${cat.gradient} text-white shadow-sm`}>
                  <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <Fragment set:html={cat.icon} />
                  </svg>
                </div>
                <span class={`px-2.5 py-1 rounded-full text-xs font-semibold border ${st.cls}`}>
                  {st.label}
                </span>
              </div>
              <h3 class="font-display font-semibold text-foreground text-lg mb-1">{cat.title}</h3>
              <p class="text-muted-foreground text-sm mb-4 leading-relaxed">{cat.claim}</p>
              <ul class="space-y-2 flex-1">
                {cat.features.map(f => (
                  <li class="flex items-center gap-2.5 text-sm text-muted-foreground">
                    <svg class={`w-3.5 h-3.5 flex-shrink-0 ${isComingSoon ? 'opacity-50' : 'text-primary'}`}
                         viewBox="0 0 24 24" fill="none" stroke={isComingSoon ? 'currentColor' : '#c4a265'}
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <Fragment set:html={IC.checkCheck} />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
              {published && (
                <span class="mt-5 pt-4 border-t border-border inline-flex items-center gap-1.5 text-sm font-medium text-primary">
                  Mehr erfahren
                  <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.arrowRight} /></svg>
                </span>
              )}
            </Card>
          </div>
        );
      })}
    </div>

    <div class="mt-10 text-center">
      <a href="/funktionen" class="inline-flex items-center gap-2 border border-border bg-card text-foreground font-semibold px-6 py-3 rounded-xl hover:bg-muted transition-colors">
        Alle Funktionen mit Screenshots ansehen
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.arrowRight} /></svg>
      </a>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-5 text-sm">
      {STATUS_ORDER.map((s) => (
        <span class={`flex items-center gap-2 px-3 py-1 rounded-full border text-xs font-medium ${STATUS[s].cls}`}>
          <span class="w-2 h-2 rounded-full bg-current" aria-hidden="true"></span>{STATUS[s].label}
        </span>
      ))}
    </div>
  </div>
</section>

<!-- ─── Why LunaFamily ────────────────────────────────────────────────────── -->
<section class="py-24 px-4 sm:px-6" aria-labelledby="why-heading">
  <div class="max-w-5xl mx-auto">
    <div class="lf-animate text-center mb-14">
      <h2 id="why-heading" class="font-display text-3xl sm:text-4xl font-bold text-foreground hyphens-auto break-words mb-4">
        Warum <span class="font-semibold">Luna</span><span class="font-script text-accent text-[1.15em]">Family</span>?
      </h2>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Statt einem Dutzend Apps, Passwörtern und Abos — alles an einem Ort, auf das sich deine Familie verlassen kann.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {WHY_CARDS.map((card, i) => (
        <div class="lf-animate h-full" style={`transition-delay:${i * 80}ms`}>
          <div class="h-full flex items-start gap-4 p-5 rounded-xl border border-border bg-card hover:border-primary/40 transition-colors">
            <div class="p-2.5 rounded-lg bg-muted flex-shrink-0">
              <svg class={`w-6 h-6 ${card.color}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <Fragment set:html={card.icon} />
              </svg>
            </div>
            <div>
              <h3 class="font-display font-semibold text-foreground mb-1.5">{card.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{card.text}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── Beta Transparency ──────────────────────────────────────────────────── -->
<section class="py-20 px-4 sm:px-6 bg-muted/30" aria-labelledby="beta-heading">
  <div class="max-w-4xl mx-auto">
    <div class="lf-animate">
      <div class="flex items-center gap-3 mb-8">
        <div class="p-2.5 rounded-xl bg-amber-100 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <Fragment set:html={IC.construction} />
          </svg>
        </div>
        <div>
          <h2 id="beta-heading" class="font-display text-2xl sm:text-3xl font-bold text-foreground">Ehrlich: Wir sind Beta</h2>
          <p class="text-muted-foreground text-sm">Und das ist kein Fehler — sondern ein Feature.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {BETA_CARDS.map((card, i) => (
          <div class="lf-animate flex items-start gap-3 p-4 rounded-xl bg-background border border-border" style={`transition-delay:${i * 60}ms`}>
            <div class="mt-0.5 flex-shrink-0">
              <svg class={`w-5 h-5 ${card.color}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <Fragment set:html={card.icon} />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-foreground text-sm mb-1">{card.title}</p>
              <p class="text-muted-foreground text-sm leading-relaxed">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ─── Roadmap ───────────────────────────────────────────────────────────── -->
<section class="py-24 px-4 sm:px-6" aria-labelledby="roadmap-heading">
  <div class="max-w-5xl mx-auto">
    <div class="lf-animate text-center mb-14">
      <h2 id="roadmap-heading" class="font-display text-3xl sm:text-4xl font-bold text-foreground hyphens-auto break-words mb-4">Unsere Roadmap</h2>
      <p class="text-muted-foreground text-lg">Transparent. Ehrlich. Immer aktuell.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="lf-animate" style="transition-delay:0ms">
        <div class="h-full rounded-xl border border-green-200 dark:border-green-800/40 bg-green-50/50 dark:bg-green-950/20 p-6">
          <h3 class="font-display font-bold text-foreground mb-4 text-base">✅ Jetzt verfügbar</h3>
          <ul class="space-y-2.5">
            {ROADMAP_DONE.map(item => (
              <li class="flex items-center gap-2.5 text-sm text-foreground/80">
                <span class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="lf-animate" style="transition-delay:100ms">
        <div class="h-full rounded-xl border border-primary/30 bg-primary/5 p-6">
          <h3 class="font-display font-bold text-foreground mb-4 text-base">🔜 Demnächst</h3>
          <ul class="space-y-2.5">
            {ROADMAP_SOON.map(item => (
              <li class="flex items-center gap-2.5 text-sm text-foreground/80">
                <span class="w-2 h-2 rounded-full bg-primary flex-shrink-0" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="lf-animate" style="transition-delay:200ms">
        <div class="h-full rounded-xl border border-border bg-card p-6">
          <h3 class="font-display font-bold text-foreground mb-4 text-base">🗺 In Planung</h3>
          <ul class="space-y-2.5">
            {ROADMAP_PLANNED.map(item => (
              <li class="flex items-center gap-2.5 text-sm text-foreground/80">
                <span class="w-2 h-2 rounded-full bg-muted-foreground/50 flex-shrink-0" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── CTA ───────────────────────────────────────────────────────────────── -->
<section class="py-24 px-4 sm:px-6 bg-muted/20" aria-labelledby="cta-heading">
  <div class="max-w-3xl mx-auto text-center">
    <div class="lf-animate">
