---
import { IC } from '../data/icons';
import { CATEGORIES, PUBLISHED, STATUS } from '../data/features';

// „Funktionen" öffnet ein Menü mit allen freigeschalteten Bereichen (je mit
// Symbol und Nutzen-Satz) und dem, was als Nächstes kommt. Eine eigene
// Übersichtsseite gibt es nicht mehr — die Übersicht steht auf der Startseite.
const upcoming = CATEGORIES.filter((c) => !PUBLISHED.includes(c)).slice(0, 5);
const current = Astro.url.pathname.replace(/\/$/, '');
const inFeatures = current.startsWith('/funktionen/');
---

<!-- ─── Navbar ─────────────────────────────────────────────────────────────── -->
<nav id="lf-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-2 min-w-0">
      <!-- Mobile: kompaktes Icon-Lockup (Wortmarke ist bei <sm zu breit fuer die Navbar) -->
      <a href="/" class="flex sm:hidden items-center gap-2 min-w-0" aria-label="LunaFamily Startseite">
        <img src="/brand/logo-icon.png" alt="" width="401" height="408" class="w-9 h-9 flex-shrink-0 dark:hidden" />
        <img src="/brand/logo-icon-dark.png" alt="" width="226" height="230" class="w-9 h-9 flex-shrink-0 hidden dark:block" />
        <span class="font-display font-semibold text-foreground truncate">LunaFamily</span>
      </a>
      <!-- Ab sm: volle Wortmarke -->
      <a href="/" class="hidden sm:flex items-center" aria-label="LunaFamily Startseite">
      <img src="/brand/logo-wordmark.png" alt="LunaFamily" width="1229" height="231" class="hidden sm:block sm:dark:hidden h-12 w-auto flex-shrink-0" />
      <img src="/brand/logo-wordmark-dark.png" alt="LunaFamily" width="1222" height="231" class="hidden sm:dark:block h-12 w-auto flex-shrink-0" />
      </a>
      <span class="hidden sm:inline-block ml-1 px-2 py-0.5 text-xs font-semibold bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 rounded-full border border-amber-200 dark:border-amber-700/60">BETA</span>
    </div>
    <div class="flex items-center gap-0.5 sm:gap-3 flex-shrink-0">
      <div id="lf-features" class="md:mr-1">
        <button id="lf-features-btn" type="button" aria-expanded="false" aria-controls="lf-features-panel"
                class={`lf-features-btn inline-flex items-center gap-1.5 p-2 md:px-3.5 rounded-lg text-sm font-medium transition-colors ${inFeatures ? 'text-foreground' : 'text-muted-foreground'} hover:text-foreground hover:bg-muted`}>
          <svg class="w-5 h-5 md:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.layoutGrid} /></svg>
          <span class="sr-only md:not-sr-only">Funktionen</span>
          <svg class="lf-chevron hidden md:block w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.chevronDown} /></svg>
        </button>

        <div id="lf-features-panel" class="lf-panel" hidden>
          <div class="max-w-6xl mx-auto px-3 sm:px-6">
            <div class="lf-panel-card rounded-2xl border border-border bg-card overflow-hidden">
              <div class="grid lg:grid-cols-[minmax(0,1fr)_19rem]">
                <!-- Verfügbare Bereiche -->
                <div class="p-3 sm:p-5 flex flex-col">
                  <p class="px-3 pt-1 pb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Das kann LunaFamily heute</p>
                  <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-1">
                    {PUBLISHED.map((cat) => {
                      const active = current === `/funktionen/${cat.slug}`;
                      return (
                        <li>
                          <a href={`/funktionen/${cat.slug}`} aria-current={active ? 'page' : undefined}
                             class={`group flex items-start gap-3 rounded-xl p-3 transition-colors ${active ? 'bg-muted' : 'hover:bg-muted'}`}>
                            <span class={`flex-shrink-0 p-2 rounded-lg bg-gradient-to-br ${cat.gradient} text-white shadow-sm transition-transform group-hover:scale-105`}>
                              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={cat.icon} /></svg>
                            </span>
                            <span class="min-w-0">
                              <span class="flex items-center gap-1.5 font-semibold text-sm text-foreground leading-tight">
                                {cat.title}
                                {cat.status === 'partial' && <span class={`w-1.5 h-1.5 rounded-full ${STATUS.partial.dot}`} title={STATUS.partial.label}></span>}
                              </span>
                              <span class="block mt-1 text-xs text-muted-foreground leading-snug">{cat.claim}</span>
                            </span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                  <div class="mt-auto pt-4 mx-3 border-t border-border flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
                    <span class="inline-flex items-center gap-2 text-xs text-muted-foreground">
                      <span class={`w-1.5 h-1.5 rounded-full ${STATUS.partial.dot}`}></span>
                      {STATUS.partial.label} – weitere Teile folgen
                    </span>
                    <a href="/#funktionen" class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline">
                      Alle Bereiche im Überblick
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.arrowRight} /></svg>
                    </a>
                  </div>
                </div>

                <!-- Was als Nächstes kommt + Einladung -->
                <div class="border-t lg:border-t-0 lg:border-l border-border bg-muted/40 p-5 flex flex-col gap-5">
                  <div>
                    <p class="pb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Als Nächstes</p>
                    <ul class="space-y-2.5">
                      {upcoming.map((cat) => (
                        <li class="flex items-center gap-2.5 text-sm text-foreground/80">
                          <span class="flex-shrink-0 p-1.5 rounded-md bg-card border border-border text-muted-foreground">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={cat.icon} /></svg>
                          </span>
                          <span class="min-w-0 truncate">{cat.title}</span>
                          <span class="ml-auto flex-shrink-0 text-[11px] text-muted-foreground">{STATUS[cat.status].label}</span>
                        </li>
                      ))}
                    </ul>
                    <a href="/#roadmap" class="inline-flex items-center gap-1 mt-3 text-xs font-semibold text-primary hover:underline">
                      Ganze Roadmap
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.arrowRight} /></svg>
                    </a>
                  </div>
                  <div class="mt-auto rounded-xl p-4 lf-panel-cta">
                    <p class="font-display font-semibold text-foreground mb-1">Kostenlos in der Beta</p>
                    <p class="text-xs text-muted-foreground leading-relaxed mb-3">Ohne Kreditkarte, in wenigen Minuten startklar.</p>
                    <a href="https://app.lunafamily.online/register" rel="noopener"
                       class="inline-flex w-full items-center justify-center gap-1.5 bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-semibold px-4 py-2 rounded-lg transition-colors">
                      Jetzt ausprobieren
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={IC.arrowRight} /></svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <button id="lf-theme-toggle" type="button" aria-label="Farbschema umschalten"
              class="p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
        <svg class="w-5 h-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <Fragment set:html={IC.moon} />
        </svg>
        <svg class="w-5 h-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <Fragment set:html={IC.sun} />
        </svg>
      </button>
      <a href="https://app.lunafamily.online/login" class="text-xs sm:text-sm text-muted-foreground hover:text-foreground transition-colors" rel="noopener">
        Anmelden
      </a>
      <a href="https://app.lunafamily.online/register"
         class="bg-primary hover:bg-primary/90 text-primary-foreground text-xs sm:text-sm font-semibold px-3 sm:px-4 py-2 rounded-lg transition-colors"
         style="box-shadow:0 4px 12px rgba(196,162,101,.2)" rel="noopener">
        Registrieren
      </a>
    </div>
  </div>
</nav>

<style>
  /* Das Menü hängt unter der ganzen Leiste, nicht unter dem Knopf. */
  .lf-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding-top: .5rem;
  }
  .lf-panel-card {
    box-shadow: 0 2px 6px rgb(40 30 10 / .06), 0 40px 80px -28px rgb(60 45 20 / .45);
  }
  :global(.dark) .lf-panel-card { box-shadow: 0 2px 6px rgb(0 0 0 / .4), 0 40px 80px -28px rgb(0 0 0 / .9); }
  .lf-panel:not([hidden]) .lf-panel-card { animation: lf-panel-in .18s ease-out; }
  @keyframes lf-panel-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .lf-panel:not([hidden]) .lf-panel-card { animation: none; } }
  /* Auf schmalen Bildschirmen scrollt das Menü selbst, falls es höher als der Bildschirm ist. */
  @media (max-width: 1023px) {
    .lf-panel-card { max-height: calc(100vh - 5rem); overflow-y: auto; }
  }
  .lf-panel-cta {
    background:
      radial-gradient(120% 100% at 0% 0%, rgb(196 162 101 / .22), transparent 60%),
      rgb(var(--color-card));
    border: 1px solid rgb(var(--color-border));
  }
  .lf-features-btn[aria-expanded='true'] { color: rgb(var(--color-foreground)); background: rgb(var(--color-muted)); }
  .lf-features-btn[aria-expanded='true'] .lf-chevron { transform: rotate(180deg); }
</style>

<script>
  // Öffnen per Klick (überall) und per Maus (am Desktop); schließen mit Esc,
  // mit einem Klick daneben oder wenn die Maus das Menü verlässt.
  const wrap = document.getElementById('lf-features');
  const btn = document.getElementById('lf-features-btn');
  const panel = document.getElementById('lf-features-panel');
  if (wrap && btn && panel) {
    let closeTimer: number | undefined;
    const hoverCapable = window.matchMedia('(hover: hover) and (min-width: 768px)');
    const isOpen = () => !panel.hidden;
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };

    // Am Desktop ist das Menü beim Klick meist schon per Maus offen — dann offen lassen.
    btn.addEventListener('click', () => setOpen(hoverCapable.matches ? true : !isOpen()));
    wrap.addEventListener('mouseenter', () => {
      if (!hoverCapable.matches) return;
      clearTimeout(closeTimer);
      setOpen(true);
    });
    wrap.addEventListener('mouseleave', () => {
      if (!hoverCapable.matches) return;
      closeTimer = window.setTimeout(() => setOpen(false), 180);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !wrap.contains(e.target as Node)) setOpen(false);
    });
    wrap.addEventListener('focusout', (e) => {
      if (e.relatedTarget && !wrap.contains(e.relatedTarget as Node)) setOpen(false);
    });
  }
</script>
