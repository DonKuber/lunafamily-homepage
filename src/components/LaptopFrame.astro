---
// Neutraler Laptop (kein bestimmtes Herstellermodell) mit einer Aufnahme der
// App im Bildschirm; hell und dunkel passend zum Farbschema der Seite.
import type { Screenshot } from '../data/features';

interface Props {
  shot: Screenshot;
  eager?: boolean;
  class?: string;
}
const { shot, eager = false, class: extra = '' } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<div class={`relative ${extra}`}>
  <div class="lf-laptop-screen relative mx-[6%] rounded-t-[1.1rem] bg-neutral-900 p-[1.3%] pb-[1.6%]">
    <span class="absolute top-[0.55%] left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-neutral-700" aria-hidden="true"></span>
    <div class="overflow-hidden rounded-md bg-black">
      <img src={`/screenshots/${shot.file}-light.webp`} alt={shot.caption} width={shot.width} height={shot.height}
           loading={loading} decoding="async" class="block w-full h-auto dark:hidden" />
      <img src={`/screenshots/${shot.file}-dark.webp`} alt={shot.caption} width={shot.width} height={shot.height}
           loading={loading} decoding="async" class="hidden w-full h-auto dark:block" />
    </div>
  </div>
  <div class="lf-laptop-base relative h-3 sm:h-4 rounded-b-2xl" aria-hidden="true">
    <span class="absolute top-0 left-1/2 -translate-x-1/2 w-[14%] h-1.5 rounded-b-lg bg-neutral-400/60"></span>
  </div>
</div>

<style>
  .lf-laptop-screen { box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .08), 0 30px 70px -25px rgb(40 30 10 / .55); }
  .lf-laptop-base {
    background: linear-gradient(180deg, #d9d4cc 0%, #b9b2a7 60%, #8f877b 100%);
    box-shadow: 0 18px 30px -12px rgb(40 30 10 / .45);
  }
  :global(.dark) .lf-laptop-base { background: linear-gradient(180deg, #5a544c 0%, #3d3832 60%, #25211d 100%); }
</style>
