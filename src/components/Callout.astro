---
// Hinweis-Chip: kurzer Nutzen, der auf eine Stelle im Bild zeigt.
import type { Callout } from '../data/features';

interface Props {
  callout: Callout;
  class?: string;
  style?: string;
}
const { callout, class: extra = '', style = '' } = Astro.props;
const ICONS: Record<string, string> = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
  heart: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
};
const icon = ICONS[callout.icon ?? 'check'];
---

<span class={`lf-callout inline-flex items-center gap-2.5 rounded-full border border-border bg-card/95 backdrop-blur px-3.5 py-2 text-sm font-semibold text-foreground whitespace-nowrap ${extra}`} style={style}>
  <span class="flex items-center justify-center w-6 h-6 rounded-full text-white" style="background:linear-gradient(135deg,#c4a265,#a8844a)">
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icon} /></svg>
  </span>
  {callout.text}
</span>

<style>
  .lf-callout { box-shadow: 0 1px 2px rgb(40 30 10 / .08), 0 12px 28px -8px rgb(60 45 20 / .35); }
  :global(.dark) .lf-callout { box-shadow: 0 1px 2px rgb(0 0 0 / .4), 0 12px 28px -8px rgb(0 0 0 / .7); }
</style>
