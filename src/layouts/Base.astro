---
import '../styles/fonts.css';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'LunaFamily – Das digitale Zuhause für deine Familie',
  description = 'Kalender, Aufgaben, Dokumente, Finanzen, Rezepte und vieles mehr — alles an einem Ort, für die ganze Familie. Endlich Schluss mit Zettel-Chaos und App-Wirrwarr.',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="theme-color" id="lf-theme-color" content="#f9f5ef" />
    <script is:inline>
      (function () {
        function setTheme(isDark) {
          document.documentElement.classList.toggle('dark', isDark);
          var meta = document.getElementById('lf-theme-color');
          if (meta) meta.setAttribute('content', isDark ? '#1a1611' : '#f9f5ef');
          try {
            localStorage.setItem('lf-theme', isDark ? 'dark' : 'light');
          } catch (e) {}
        }
        window.__lfSetTheme = setTheme;

        var stored = null;
        try {
          stored = localStorage.getItem('lf-theme');
        } catch (e) {}
        var isDark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        setTheme(isDark);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <slot />
  </body>
</html>
