---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/fonts.css';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Teilen-Vorschaubild unter public/og/, z. B. "kalender" (siehe scripts/render-og.mjs). */
  ogImage?: string;
}

const {
  title = 'LunaFamily – Das digitale Zuhause für deine Familie',
  description = 'Kalender, Aufgaben, Dokumente, Verträge, Kontakte und vieles mehr — alles an einem Ort, für die ganze Familie. Endlich Schluss mit Zettel-Chaos und App-Wirrwarr.',
  noindex = false,
  ogImage = 'start',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Nur verlinken, was es gibt — ein kaputtes Vorschaubild ist schlechter als keins.
const ogFile = [ogImage, 'start'].find((name) => existsSync(join(process.cwd(), 'public', 'og', `${name}.jpg`)));
const ogImageURL = ogFile ? new URL(`/og/${ogFile}.jpg`, Astro.site) : null;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="theme-color" id="lf-theme-color" content="#f9f5ef" />
    <script is:inline>
      (function () {
        function setTheme(isDark) {
          document.documentElement.classList.toggle('dark', isDark);
          var meta = document.getElementById('lf-theme-color');
          if (meta) meta.setAttribute('content', isDark ? '#1a1611' : '#f9f5ef');
          try {
            localStorage.setItem('lf-theme', isDark ? 'dark' : 'light');
          } catch (e) {}
        }
        window.__lfSetTheme = setTheme;

        var stored = null;
        try {
          stored = localStorage.getItem('lf-theme');
        } catch (e) {}
        var isDark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        setTheme(isDark);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    {ogImageURL && (
      <>
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImageURL} />
      </>
    )}
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <slot />
    {/* Cookielose Reichweitenmessung für die Homepage-Statistik im ControlPanel
        (Site-Key "lunafamily" = productKey des Programms). Setzt keine Cookies und
        nutzt keinen Speicher im Browser; IDs im Pfad werden vor dem Senden
        entfernt, von localhost und bei „Do Not Track“/GPC wird nichts gesendet. Code identisch mit dem
        Snippet unter /statistics/homepage im ControlPanel. */}
    <script is:inline>(function(){var u="https://control.theraluna.de/api/visit",k="lunafamily",l=location;if(/^(localhost|127\.0\.0\.1|\[::1\])$/.test(l.hostname)||navigator.doNotTrack==="1"||window.doNotTrack==="1"||navigator.globalPrivacyControl===true)return;function id(s){return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(s)||/^\d+$/.test(s)||/^[A-Z]{2,4}-\d{3,}$/.test(s)||(s.length>=16&&/\d/.test(s)&&/^[A-Za-z0-9_-]+$/.test(s)&&!/^[a-z]+(?:-[a-z0-9]+)+$/.test(s));}function norm(p){return(p||"/").split("/").map(function(s){return id(s)?":id":s;}).join("/");}var r=document.referrer,p=norm(l.pathname),t=Date.now();function send(){if(!p)return;var d=Math.round((Date.now()-t)/1000),b=JSON.stringify({site:k,page:p,referrer:r||undefined,duration:d>=1?d:undefined});p=null;r="";try{if(navigator.sendBeacon&&navigator.sendBeacon(u,new Blob([b],{type:"application/json"})))return;}catch(e){}try{fetch(u,{method:"POST",headers:{"Content-Type":"application/json"},body:b,keepalive:true}).catch(function(){});}catch(e){}}function nav(){var n=norm(l.pathname);if(n===p)return;send();p=n;t=Date.now();}["pushState","replaceState"].forEach(function(m){var o=history[m];history[m]=function(){var x=o.apply(this,arguments);setTimeout(nav,0);return x;};});addEventListener("popstate",nav);addEventListener("pagehide",send);document.addEventListener("visibilitychange",function(){if(document.visibilityState==="hidden")send();});})();</script>
  </body>
</html>
