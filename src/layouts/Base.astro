---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/fonts.css';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Teilen-Vorschaubild unter public/og/, z. B. "kalender" (siehe scripts/render-og.mjs). */
  ogImage?: string;
}

const {
  title = 'LunaFamily – Das digitale Zuhause für deine Familie',
  description = 'Kalender, Aufgaben, Dokumente, Verträge, Kontakte und vieles mehr — alles an einem Ort, für die ganze Familie. Endlich Schluss mit Zettel-Chaos und App-Wirrwarr.',
  noindex = false,
  ogImage = 'start',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Nur verlinken, was es gibt — ein kaputtes Vorschaubild ist schlechter als keins.
const ogFile = [ogImage, 'start'].find((name) => existsSync(join(process.cwd(), 'public', 'og', `${name}.jpg`)));
const ogImageURL = ogFile ? new URL(`/og/${ogFile}.jpg`, Astro.site) : null;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="theme-color" id="lf-theme-color" content="#f9f5ef" />
    <script is:inline>
      (function () {
        function setTheme(isDark) {
          document.documentElement.classList.toggle('dark', isDark);
          var meta = document.getElementById('lf-theme-color');
          if (meta) meta.setAttribute('content', isDark ? '#1a1611' : '#f9f5ef');
          try {
            localStorage.setItem('lf-theme', isDark ? 'dark' : 'light');
          } catch (e) {}
        }
        window.__lfSetTheme = setTheme;

        var stored = null;
        try {
          stored = localStorage.getItem('lf-theme');
        } catch (e) {}
        var isDark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        setTheme(isDark);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    {ogImageURL && (
      <>
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImageURL} />
      </>
    )}
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <!--
      Wartungshinweis aus dem ControlPanel (Register-Tab „Wartungsmodus der
      Homepage“, CP-Vertrag v1 2026-10-02). Öffentliche Route, CORS offen,
      ohne Zugangsdaten. Fehler oder keine Antwort → Seite normal, kein Banner.
    -->
    <div
      id="lf-wartung"
      role="status"
      hidden
      class="sticky top-0 z-[60] w-full bg-amber-100 text-amber-950 border-b border-amber-300 px-4 py-3 text-sm text-center"
    ></div>
    <script is:inline>
      (function () {
        var url =
          'https://control.theraluna.de/api/programs/homepage/v1/dcad9050-69ca-46bd-98e9-31ece3906af1/access-status';
        var ctrl = 'AbortController' in window ? new AbortController() : null;
        var timer = setTimeout(function () { if (ctrl) ctrl.abort(); }, 4000);
        fetch(url, { credentials: 'omit', signal: ctrl ? ctrl.signal : undefined })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            clearTimeout(timer);
            var w = d && d.maintenance;
            if (!w || w.active !== true) return;
            var box = document.getElementById('lf-wartung');
            if (!box) return;
            var titel = document.createElement('strong');
            titel.textContent = 'Wartungsarbeiten: ';
            box.appendChild(titel);
            box.appendChild(
              document.createTextNode(
                (w.reason && String(w.reason).trim()) ||
                  'LunaFamily wird gerade gewartet. Einige Funktionen sind vorübergehend nicht verfügbar.'
              )
            );
            if (w.until) {
              var bis = new Date(w.until);
              if (!isNaN(bis.getTime())) {
                box.appendChild(
                  document.createTextNode(
                    ' Voraussichtlich bis ' +
                      bis.toLocaleString('de-DE', {
                        timeZone: 'Europe/Berlin',
                        day: '2-digit', month: '2-digit',
                        hour: '2-digit', minute: '2-digit',
                      }) + ' Uhr.'
                  )
                );
              }
            }
            box.hidden = false;
          })
          .catch(function () { clearTimeout(timer); });
      })();
    </script>
    <slot />
  </body>
</html>
